---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import podjetje from '../content/nastavitve/podjetje.json';

const stran = (await getEntry('strani', 'o-nas'))!;
const { Content } = await render(stran);
const zemljevid = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${podjetje.naslov}, ${podjetje.posta}`)}`;
---
<Base title={stran.data.naslov} description="Aplicom d.o.o. iz Novega mesta razvija poslovne programe od leta 1988.">
  <section class="page-head">
    <div class="wrap">
      <div>
        <h1>{stran.data.naslov}</h1>
        <p>{podjetje.uradni_naziv}</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap detail-grid">
      <div class="card card-pad"><div class="prose"><Content /></div></div>
      <aside class="detail-aside">
        <div class="card card-pad">
          <h3>{podjetje.naziv}</h3>
          <div class="info-row"><Icon name="pin" /><p>{podjetje.naslov}<br />{podjetje.posta}<br /><a href={zemljevid} target="_blank" rel="noopener">Pokaži na zemljevidu</a></p></div>
          <div class="info-row"><Icon name="phone" /><p>{podjetje.telefoni.join(', ')}</p></div>
          <div class="info-row"><Icon name="mail" /><p><a href={`mailto:${podjetje.email}`}>{podjetje.email}</a></p></div>
          <div class="info-row" style="margin:0"><Icon name="clock" /><p>Telefonska pomoč {podjetje.pomoc_cas}</p></div>
        </div>
      </aside>
    </div>
  </section>
</Base>
