---
import Base from '../layouts/Base.astro';
---
<Base title="Stran ne obstaja">
  <section class="section">
    <div class="wrap" style="max-width:640px;text-align:center;padding-top:40px">
      <h1>Strani ni mogoče najti</h1>
      <p class="muted">Stran je bila morda premaknjena. Zadnje verzije programov najdete med prenosi.</p>
      <p style="margin-top:28px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href="/prenosi/">Prenosi</a>
        <a class="btn btn-ghost" href="/">Domača stran</a>
      </p>
    </div>
  </section>
</Base>
