---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { datum } from '../../lib/util';

export async function getStaticPaths() {
  const novice = await getCollection('novice');
  return novice.map((n) => ({ params: { id: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
const imaBesedilo = (n.body ?? '').trim().length > 0;
---
<Base title={n.data.naslov} description={n.data.povzetek}>
  <section class="page-head">
    <div class="wrap">
      <div>
        <div class="crumbs"><a href="/aktualno/">Aktualno</a> / <time datetime={n.data.datum.toISOString().slice(0, 10)}>{datum(n.data.datum)}</time></div>
        <h1>{n.data.naslov}</h1>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <article class="card card-pad">
        <div class="prose">
          {imaBesedilo ? <Content /> : <p>{n.data.povzetek}</p>}
        </div>
      </article>
      <p style="margin-top:24px"><a href="/aktualno/">← Vse novice</a></p>
    </div>
  </section>
</Base>
