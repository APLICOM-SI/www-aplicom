---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import podjetje from '../content/nastavitve/podjetje.json';
import { datum, zadnjePosodobitve } from '../lib/util';

const zadnje = await zadnjePosodobitve(6);
const obvestila = await getEntry('strani', 'obvestila');
const { Content: Obvestila } = obvestila ? await render(obvestila) : { Content: null };
// Prazna obvestila v administraciji pomenijo: okvirja in gumba ne prikazujemo.
const imaObvestila = !!Obvestila && (obvestila?.body ?? '').trim().length > 0;

const podrocja = [
  { ico: 'chart', naslov: 'Poslovanje in plače', opis: 'Program Posli – kompletno poslovanje za podjetja, samostojne podjetnike in računovodske servise: od fakturiranja in zalog do plač, DDV in knjiženja.' },
  { ico: 'users', naslov: 'Za računovodske servise', opis: 'Glavna knjiga, obresti, uvoz izpiskov in prenos podatkov od strank – vse za delo z več podjetji.' },
  { ico: 'receipt', naslov: 'Blagajne in gostinstvo', opis: 'Programa Blagajna za trgovine in ApPOS za gostinske lokale, z davčnim potrjevanjem računov in prenosom v program Posli.' },
] as const;
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{podjetje.uradni_naziv}</span>
        <h1>Poslovni programi za <em>računovodske servise</em>, podjetja in obrtnike</h1>
        <p class="lead">Od leta 1988 razvijamo programe, ki jim zaupa več kot 700 strank po Sloveniji. Ustvarjamo nove ideje – in jih sproti prilagajamo zakonodaji.</p>
        {imaObvestila && (
          <div class="ctas">
            <a class="btn btn-light" href="#obvestila"><Icon name="alert" /> Pomembna obvestila</a>
          </div>
        )}
      </div>
      <div class="hero-side">
        <div class="hero-panel">
          <h2>Zadnje posodobitve</h2>
          <ul>
            {zadnje.map((p) => (
              <li>
                <a href={`/prenosi/${p.id}/`}>
                  <span class="n">{p.data.naziv.split(" - ")[0]}</span>
                  <span class="v">{p.data.verzija} · {datum(p.data.datum)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="ctas">
          <a class="btn btn-light" href="/prenosi/"><Icon name="download" /> Zadnje verzije programov</a>
          <a class="btn btn-outline-light" href="/ceniki/">Cenik</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="stats">
      <div class="card stat"><b>od 1988</b><span>razvijamo poslovne aplikacije</span></div>
      <div class="card stat"><b>700+</b><span>aktivnih strank v Sloveniji</span></div>
      <div class="card stat"><b>60+</b><span>računovodskih servisov</span></div>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Kaj ponujamo</h2>
        <a href="/prenosi/">Vsi programi →</a>
      </div>
      <div class="grid grid-3">
        {podrocja.map((p) => (
          <div class="card feature">
            <div class="ico"><Icon name={p.ico} /></div>
            <h3>{p.naslov}</h3>
            <p>{p.opis}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {imaObvestila && Obvestila && (
    <section class="section" style="padding-top:0" id="obvestila">
      <div class="wrap">
        <div class="notice">
          <h2><Icon name="alert" /> Pomembna obvestila</h2>
          <div class="prose"><Obvestila /></div>
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="help-band">
        <div>
          <h2>Potrebujete pomoč?</h2>
          <p>Telefonska pomoč {podjetje.pomoc_cas} za stranke z vzdrževalno pogodbo.</p>
        </div>
        <div class="ctas">
          <a class="btn btn-light" href={`tel:+386${podjetje.telefoni[0].replace(/\D/g, '').replace(/^0/, '')}`}><Icon name="phone" /> {podjetje.telefoni[0]}</a>
          <a class="btn btn-outline-light" href={podjetje.pomoc_url} target="_blank" rel="noopener"><Icon name="monitor" /> Pomoč na daljavo</a>
        </div>
      </div>
    </div>
  </section>
</Base>
